# Local (non-CI) build: copy to .env, fill in, then `set -a; source .env; set +a`
# before running packer/build.sh. Never commit the real .env.
# In GitHub Actions these come from repository secrets/variables instead.

# vSphere account Packer uses to build and publish (least privilege).
PKR_VAR_vsphere_username="<VSPHERE_SERVICE_ACCOUNT>@vsphere.local"
PKR_VAR_vsphere_password="<VSPHERE_PASSWORD>"

# Guest build account. build_password_encrypted is the crypted form
# (e.g. `openssl passwd -6`) used by the kickstart.
PKR_VAR_build_password="<BUILD_PASSWORD>"
PKR_VAR_build_password_encrypted="<BUILD_PASSWORD_SHA512_CRYPT>"
PKR_VAR_build_key="ssh-ed25519 AAAA... packer@example"
PKR_VAR_ansible_key="ssh-ed25519 AAAA... ansible@example"

# RHEL builds only. Special characters (&, $, ;, quotes) are fine: the
# kickstart passes these base64-encoded and quotes them.
PKR_VAR_rhsm_username="<RHSM_USERNAME>"
PKR_VAR_rhsm_password="<RHSM_PASSWORD>"

# Content Library helper scripts (scripts/*.sh).
VCENTER="vcenter.example.com"
VCENTER_USERNAME="<VCENTER_READ_ACCOUNT>@vsphere.local"
VCENTER_PASSWORD="<VCENTER_PASSWORD>"
